{
  "manifest_version": 3,
  "name": "Revyy: Quiz this page",
  "version": "1.0.1",
  "description": "Reading an article? Turn it into a Revyy quiz in one click.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://revyy.app/*"],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Quiz this page with Revyy",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://revyy.app/*"],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
